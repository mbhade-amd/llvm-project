; CHECK:       [[MIDDLE_BLOCK]]:
; CHECK-NEXT:    [[CMP_N:%.*]] = icmp eq i64 [[N]], [[N_VEC]]
; CHECK-NEXT:    br i1 [[CMP_N]], label %[[EXIT:.*]], label %[[SCALAR_PH]]
; CHECK:       [[SCALAR_PH]]:
; CHECK-NEXT:    [[BC_RESUME_VAL:%.*]] = phi i64 [ [[N_VEC]], %[[MIDDLE_BLOCK]] ], [ 0, %[[ENTRY]] ], [ 0, %[[VECTOR_MEMCHECK]] ]
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ [[BC_RESUME_VAL]], %[[SCALAR_PH]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[P0:%.*]] = getelementptr inbounds i8, ptr [[PIX]], i64 [[IV]]
; CHECK-NEXT:    [[B0:%.*]] = load i8, ptr [[P0]], align 1
; CHECK-NEXT:    [[P1:%.*]] = getelementptr inbounds i8, ptr [[P0]], i64 1
; CHECK-NEXT:    [[B1:%.*]] = load i8, ptr [[P1]], align 1
; CHECK-NEXT:    [[P2:%.*]] = getelementptr inbounds i8, ptr [[P0]], i64 2
; CHECK-NEXT:    [[B2:%.*]] = load i8, ptr [[P2]], align 1
; CHECK-NEXT:    [[Z0:%.*]] = zext i8 [[B0]] to i64
; CHECK-NEXT:    [[Z1:%.*]] = zext i8 [[B1]] to i64
; CHECK-NEXT:    [[Z2:%.*]] = zext i8 [[B2]] to i64
; CHECK-NEXT:    [[M0:%.*]] = mul nuw nsw i64 [[Z0]], 54
; CHECK-NEXT:    [[M1:%.*]] = mul nuw nsw i64 [[Z1]], 183
; CHECK-NEXT:    [[M2:%.*]] = mul nuw nsw i64 [[Z2]], 19
; CHECK-NEXT:    [[ADD:%.*]] = add nuw nsw i64 [[M0]], [[M1]]
; CHECK-NEXT:    [[SUM:%.*]] = add nuw nsw i64 [[ADD]], [[M2]]
; CHECK-NEXT:    [[SH:%.*]] = lshr i64 [[SUM]], 8
; CHECK-NEXT:    [[GW:%.*]] = getelementptr inbounds float, ptr [[WEIGHTS]], i64 [[SH]]
; CHECK-NEXT:    [[W:%.*]] = load float, ptr [[GW]], align 4
; CHECK-NEXT:    [[ZI:%.*]] = zext i8 [[B0]] to i64
; CHECK-NEXT:    [[GC:%.*]] = getelementptr inbounds [12 x i8], ptr [[CURVES]], i64 [[ZI]]
; CHECK-NEXT:    [[C:%.*]] = load float, ptr [[GC]], align 4
; CHECK-NEXT:    [[GO:%.*]] = getelementptr inbounds float, ptr [[OUT]], i64 [[IV]]
; CHECK-NEXT:    [[S:%.*]] = fadd float [[W]], [[C]]
; CHECK-NEXT:    store float [[S]], ptr [[GO]], align 4
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT]], label %[[LOOP]], !llvm.loop [[LOOP33:![0-9]+]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %p0 = getelementptr inbounds i8, ptr %pix, i64 %iv
  %b0 = load i8, ptr %p0, align 1
  %p1 = getelementptr inbounds i8, ptr %p0, i64 1
  %b1 = load i8, ptr %p1, align 1
  %p2 = getelementptr inbounds i8, ptr %p0, i64 2
  %b2 = load i8, ptr %p2, align 1
  %z0 = zext i8 %b0 to i64
  %z1 = zext i8 %b1 to i64
  %z2 = zext i8 %b2 to i64
  %m0 = mul nuw nsw i64 %z0, 54
  %m1 = mul nuw nsw i64 %z1, 183
  %m2 = mul nuw nsw i64 %z2, 19
  %add = add nuw nsw i64 %m0, %m1
  %sum = add nuw nsw i64 %add, %m2
  %sh = lshr i64 %sum, 8
  %gw = getelementptr inbounds float, ptr %weights, i64 %sh
  %w = load float, ptr %gw, align 4
  %zi = zext i8 %b0 to i64
  %gc = getelementptr inbounds [12 x i8], ptr %curves, i64 %zi
  %c = load float, ptr %gc, align 4
  %go = getelementptr inbounds float, ptr %out, i64 %iv
  %s = fadd float %w, %c
  store float %s, ptr %go, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; The same loop with lshr of an unconstrained i64 stays scalar.
define void @gather_lshr_unknown(ptr %out, ptr %tab, ptr %idx, i64 %n) {
; CHECK-LABEL: define void @gather_lshr_unknown(
; CHECK-SAME: ptr [[OUT:%.*]], ptr [[TAB:%.*]], ptr [[IDX:%.*]], i64 [[N:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[PU:%.*]] = getelementptr inbounds i64, ptr [[IDX]], i64 [[IV]]
; CHECK-NEXT:    [[UNK:%.*]] = load i64, ptr [[PU]], align 8
; CHECK-NEXT:    [[SH:%.*]] = lshr i64 [[UNK]], 8
; CHECK-NEXT:    [[GT:%.*]] = getelementptr inbounds float, ptr [[TAB]], i64 [[SH]]
; CHECK-NEXT:    [[V:%.*]] = load float, ptr [[GT]], align 4
; CHECK-NEXT:    [[GO:%.*]] = getelementptr inbounds float, ptr [[OUT]], i64 [[IV]]
; CHECK-NEXT:    store float [[V]], ptr [[GO]], align 4
; CHECK-NEXT:    [[IV_NEXT]] = add nuw nsw i64 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp eq i64 [[IV_NEXT]], [[N]]
; CHECK-NEXT:    br i1 [[EC]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %pu = getelementptr inbounds i64, ptr %idx, i64 %iv
  %unk = load i64, ptr %pu, align 8
  %sh = lshr i64 %unk, 8
  %gt = getelementptr inbounds float, ptr %tab, i64 %sh
  %v = load float, ptr %gt, align 4
  %go = getelementptr inbounds float, ptr %out, i64 %iv
  store float %v, ptr %go, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}
