  store float %v, ptr %gep.out, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
  ret void
}

; Negative test: every underlying object of a select must have an exact size.
define void @select_global_byref_i32(ptr %out, ptr byref([128 x float]) %arg, i1 %c, ptr %idx, i64 %n) {
