  %gep.out = getelementptr inbounds float, ptr %out, i64 %iv
  store float %v, ptr %gep.out, align 4
  %iv.next = add nuw nsw i64 %iv, 1
  %ec = icmp eq i64 %iv.next, %n
  br i1 %ec, label %exit, label %loop

exit:
